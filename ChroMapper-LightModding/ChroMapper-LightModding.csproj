<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>latest</LangVersion>
		<RootNamespace>ChroMapper_LightModding</RootNamespace>
		<AssemblyName>ChroMapper-AutoModder</AssemblyName>
		<OutputType>Library</OutputType>
		<Deterministic>true</Deterministic>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<OutputPath>bin\Debug\</OutputPath>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<WarningLevel>4</WarningLevel>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<OutputPath>bin\Release\</OutputPath>
		<DefineConstants>TRACE</DefineConstants>
		<WarningLevel>4</WarningLevel>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="FileBrowser">
			<HintPath>$(ChroMapperDir)\ChroMapper_Data\Managed\FileBrowser.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Main">
			<HintPath>$(ChroMapperDir)\ChroMapper_Data\Managed\Main.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Plugins">
			<HintPath>$(ChroMapperDir)\ChroMapper_Data\Managed\Plugins.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.InputSystem">
			<HintPath>$(ChroMapperDir)\ChroMapper_Data\Managed\Unity.InputSystem.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(ChroMapperDir)\ChroMapper_Data\Managed\Unity.TextMeshPro.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(ChroMapperDir)\ChroMapper_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.ImageConversionModule">
			<HintPath>$(ChroMapperDir)\ChroMapper_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.IMGUIModule">
			<HintPath>$(ChroMapperDir)\ChroMapper_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(ChroMapperDir)\ChroMapper_Data\Managed\UnityEngine.UI.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<!-- Same version as the Analyzer, only referenced here to locate the native library to ship with the plugin -->
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" GeneratePathProperty="true" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="NVorbis" Version="0.10.5" />
		<PackageReference Include="ricaun.ILRepack" Version="1.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.IO.Compression" Version="4.3.0" />
		<PackageReference Include="System.IO.Compression.ZipFile" Version="4.3.0" />
		<PackageReference Include="System.Text.Json" Version="9.0.9" />
	</ItemGroup>

	<!-- ILRepack merges into the compiled assembly. When nothing was recompiled, that assembly is already merged,
	     and merging it again fails with duplicate types. -->
	<Target Name="ILRepackTimeStampBeforeCompile" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<ILRepackAssemblyTimeBefore Condition="Exists('@(IntermediateAssembly)')">%(IntermediateAssembly.ModifiedTime)</ILRepackAssemblyTimeBefore>
		</PropertyGroup>
	</Target>
	<Target Name="SkipILRepackWhenUpToDate" AfterTargets="CoreCompile">
		<PropertyGroup>
			<ILRepackAssemblyTimeAfter Condition="Exists('@(IntermediateAssembly)')">%(IntermediateAssembly.ModifiedTime)</ILRepackAssemblyTimeAfter>
			<ILRepackEnabled Condition="'$(ILRepackAssemblyTimeBefore)' != '' and '$(ILRepackAssemblyTimeBefore)' == '$(ILRepackAssemblyTimeAfter)'">false</ILRepackEnabled>
		</PropertyGroup>
	</Target>

	<ItemGroup>
		<!-- Unity provides System.Memory as a facade of mscorlib. Merging the package one would create a second ReadOnlySpan
		     type, and calls between assemblies built against different ones fail (ONNX Runtime used by the Analyzer). -->
		<ILRepackIgnoreReferences Include="System.Memory" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Assets\Icon.png" />
		<EmbeddedResource Include="manifest.json" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\BLMapCheck\BLMapCheck.csproj" />
	  <ProjectReference Include="..\SubModule\beatleader-analyzer\Parser\beatleader-parser\Parser.csproj" />
	  <ProjectReference Include="..\SubModule\beatleader-analyzer\beatleader-analyzer\Analyzer.csproj" />
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="xcopy /y /d  &quot;$(TargetPath)&quot; &quot;$(ChroMapperDir)\Plugins&quot;" />
		<!-- Native ONNX Runtime for the Analyzer parity model, loaded by OnnxRuntimeLoader. It must not be in the Plugins
		     folder, ChroMapper tries to load every dll there as a managed assembly. -->
		<Exec Command="xcopy /y /d  &quot;$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\*.dll&quot; &quot;$(ChroMapperDir)\ChroMapper_Data\Plugins\x86_64\&quot;" />
	</Target>

	<!-- Release zips for each OS, with the plugin and the native ONNX Runtime (same version as the managed one) in the
	     folders ChroMapper and Unity load them from. Extract them in the ChroMapper folder. -->
	<PropertyGroup>
		<OnnxNative>$(PkgMicrosoft_ML_OnnxRuntime)\runtimes</OnnxNative>
		<WindowsPluginFolder>Plugins</WindowsPluginFolder>
		<WindowsNativeFolder>ChroMapper_Data\Plugins\x86_64</WindowsNativeFolder>
		<LinuxPluginFolder>Plugins</LinuxPluginFolder>
		<LinuxNativeFolder>ChroMapper_Data\Plugins</LinuxNativeFolder>
		<MacPluginFolder>Plugins</MacPluginFolder>
		<!-- The macOS zip is extracted inside ChroMapper.app -->
		<MacNativeFolder>Contents\Plugins</MacNativeFolder>
	</PropertyGroup>

	<Target Name="CreatePackages" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<PackageOutputDir>$(OutDir)Packages\</PackageOutputDir>
			<PackageStagingDir>$(IntermediateOutputPath)Packages\</PackageStagingDir>
		</PropertyGroup>
		<RemoveDir Directories="$(PackageStagingDir);$(PackageOutputDir)" />

		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStagingDir)Windows\$(WindowsPluginFolder)" />
		<Copy SourceFiles="$(OnnxNative)\win-x64\native\onnxruntime.dll;$(OnnxNative)\win-x64\native\onnxruntime_providers_shared.dll" DestinationFolder="$(PackageStagingDir)Windows\$(WindowsNativeFolder)" />

		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStagingDir)Linux\$(LinuxPluginFolder)" />
		<Copy SourceFiles="$(OnnxNative)\linux-x64\native\libonnxruntime.so;$(OnnxNative)\linux-x64\native\libonnxruntime_providers_shared.so" DestinationFolder="$(PackageStagingDir)Linux\$(LinuxNativeFolder)" />

		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStagingDir)Mac\$(MacPluginFolder)" />
		<MakeUniversalMachO Inputs="$(OnnxNative)\osx-x64\native\libonnxruntime.dylib;$(OnnxNative)\osx-arm64\native\libonnxruntime.dylib" Output="$(PackageStagingDir)Mac\$(MacNativeFolder)\libonnxruntime.dylib" />

		<MakeDir Directories="$(PackageOutputDir)" />
		<ZipDirectory SourceDirectory="$(PackageStagingDir)Windows" DestinationFile="$(PackageOutputDir)$(AssemblyName)-Windows-x64.zip" Overwrite="true" />
		<ZipDirectory SourceDirectory="$(PackageStagingDir)Linux" DestinationFile="$(PackageOutputDir)$(AssemblyName)-Linux-x64.zip" Overwrite="true" />
		<ZipDirectory SourceDirectory="$(PackageStagingDir)Mac" DestinationFile="$(PackageOutputDir)$(AssemblyName)-Mac.zip" Overwrite="true" />
		<Message Importance="high" Text="Packages created in $(PackageOutputDir)" />
	</Target>

	<!-- Merges the x64 and arm64 macOS libraries into one universal library, like lipo -create -->
	<UsingTask TaskName="MakeUniversalMachO" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<Inputs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
			<Output ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Using Namespace="System" />
			<Using Namespace="System.IO" />
			<Code Type="Fragment" Language="cs"><![CDATA[
				const uint Align = 1u << 14;
				Func<uint, uint> alignUp = v => (v + Align - 1) & ~(Align - 1);
				var slices = new byte[Inputs.Length][];
				for (int i = 0; i < Inputs.Length; i++)
				{
					slices[i] = File.ReadAllBytes(Inputs[i].ItemSpec);
					if (BitConverter.ToUInt32(slices[i], 0) != 0xFEEDFACF) throw new Exception(Inputs[i].ItemSpec + " is not a 64-bit Mach-O library");
				}
				Directory.CreateDirectory(Path.GetDirectoryName(Output));
				using (var o = new BinaryWriter(File.Create(Output)))
				{
					Action<uint> be = v => o.Write(new[] { (byte)(v >> 24), (byte)(v >> 16), (byte)(v >> 8), (byte)v });
					// Fat header, then one entry per architecture (cpu type, subtype, offset, size, alignment), all big-endian
					be(0xCAFEBABE);
					be((uint)slices.Length);
					uint offset = alignUp(8 + 20 * (uint)slices.Length);
					var offsets = new uint[slices.Length];
					for (int i = 0; i < slices.Length; i++)
					{
						offsets[i] = offset;
						be(BitConverter.ToUInt32(slices[i], 4));
						be(BitConverter.ToUInt32(slices[i], 8));
						be(offset);
						be((uint)slices[i].Length);
						be(14);
						offset = alignUp(offset + (uint)slices[i].Length);
					}
					for (int i = 0; i < slices.Length; i++)
					{
						o.Write(new byte[offsets[i] - o.BaseStream.Position]);
						o.Write(slices[i]);
					}
				}
			]]></Code>
		</Task>
	</UsingTask>
</Project>